# ============================================================
# PATIL HOSPITAL – Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git
# ============================================================

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

# SMS OTP (optional – leave blank to use email OTP / dev mode)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# Razorpay – get from https://razorpay.com (use TEST mode keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
